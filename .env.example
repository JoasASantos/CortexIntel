# CortexIntel — model providers & cognitive layer (copy to .env; never commit .env)

# Language for every generated text (pt | es | en). The GUI also passes its own.
CORTEX_LANG=pt

# --- CLI providers (already-authenticated tools on PATH) ---
# CORTEX_CLAUDE_BIN=claude
# CORTEX_CODEX_BIN=codex
# CORTEX_GEMINI_BIN=gemini

# --- Operator pins per task tier (optional; otherwise base-score routing) ---
# CORTEX_MODEL_COMPLEX=claude-opus-5
# CORTEX_MODEL_STANDARD=claude-sonnet-5
# CORTEX_MODEL_SIMPLE=gpt-5.6-luna

# --- OpenAI-compatible HTTP APIs (via curl) — provider id becomes api:<name> ---
# CORTEX_API_DEEPSEEK_KEY=sk-...
# CORTEX_API_KIMI_KEY=sk-...
# CORTEX_API_QWEN_KEY=sk-...
# CORTEX_API_OPENROUTER_KEY=sk-or-...
# CORTEX_API_OLLAMA_URL=http://127.0.0.1:11434/v1
# CORTEX_API_<NAME>_URL=https://host/v1        # base URL (defaults exist for kimi/qwen/deepseek/openrouter/openai/groq/mistral/ollama)
# CORTEX_API_<NAME>_MODEL=model-id             # default model for that API

# --- Generic CLIs (prompt on stdin → answer on stdout, or {prompt} placeholder) ---
# CORTEX_LLM_CMD=ollama run llama3
# CORTEX_HERMES_CMD=hermes chat --model ...
# CORTEX_OPENCODE_CMD=opencode run --model ...

# --- Register newer models without rebuilding (JSON array of ModelSpec) ---
# CORTEX_MODELS_JSON=[{"id":"gpt-6.1-nova","provider":"codex","family":"gpt","reasoning":9.9,"speed":7,"cost":3,"context_k":1000,"usd_per_1k":0.04,"strengths":["deep-reasoning","code"]}]

# --- Token / cost governor ---
# CORTEX_TOKEN_BUDGET=400000            # per job (scaled by workload)
# CORTEX_USD_BUDGET=3.0                 # per job
# CORTEX_TOKEN_BUDGET_GLOBAL=5000000    # per server session
# CORTEX_USD_BUDGET_GLOBAL=40

# --- Prompt / semantic cache ---
# CORTEX_LLM_CACHE=1
# CORTEX_LLM_CACHE_TTL_H=72

# --- Embeddings (enables vector retrieval + semantic cache) ---
# CORTEX_EMBED_CMD=python3 embed.py     # reads text on stdin, prints a JSON float array

# --- Misc ---
# CORTEX_VERBOSE=1                       # mirror bus events to stderr
# CORTEX_LLM_RETRIES=1
